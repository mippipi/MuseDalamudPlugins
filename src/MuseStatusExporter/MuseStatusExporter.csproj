<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

	<PropertyGroup>
		<Version>1.19.0</Version>
		<Authors>Muse</Authors>
		<Description>Exports the logged-in character's job levels, Cosmic Exploration progress, gearsets and equipped items to a JSON file.</Description>
		<RootNamespace>MuseStatusExporter</RootNamespace>
		<AssemblyName>MuseStatusExporter</AssemblyName>
		<TargetFramework>net10.0-windows8.0</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="MuseStatusExporter.json" />
	</ItemGroup>

</Project>
